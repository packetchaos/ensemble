  "services": [
    {
      "bom-ref": "svc:tenable-vulnerability-management-tenable-one-api",
      "name": "Tenable Vulnerability Management / Tenable One API",
      "endpoints": [
        "https://cloud.tenable.com"
      ],
      "authenticated": true,
      "x-trust-boundary": true,
      "description": "always — every Tenable read and write goes through the navi CLI with its own API keys",
      "data": [
        {
          "flow": "bi-directional",
          "classification": "asset, finding, tag, scan and ACR data both ways (writes only through the write gates)"
        }
      ],
      "properties": [
        {
          "name": "ensemble:used-by",
          "value": "navi CLI"
        }
      ]
    },
    {
      "bom-ref": "svc:anthropic-api",
      "name": "Anthropic API",
      "endpoints": [
        "https://api.anthropic.com"
      ],
      "authenticated": true,
      "x-trust-boundary": true,
      "description": "optional — when an AI provider is configured (BYO_MODEL.md)",
      "data": [
        {
          "flow": "bi-directional",
          "classification": "prompts built from navi.db findings / asset facts go out; text comes back"
        }
      ],
      "properties": [
        {
          "name": "ensemble:used-by",
          "value": "core/llm.py"
        }
      ]
    },
    {
      "bom-ref": "svc:openai-compatible-endpoint",
